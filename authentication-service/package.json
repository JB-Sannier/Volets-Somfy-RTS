{
  "name": "authentication-service",
  "version": "1.0.0",
  "description": "Internal Authentication Service",
  "license": "ISC",
  "author": "",
  "main": "main.js",
  "scripts": {
    "build": "tsc && cp package*.json .env build/ && cd build && npm install --omit=dev",
    "format": "prettier --write src/**/*.ts",
    "lint": "eslint src/**/*.ts",
    "biome-lint:fix": "npx @biomejs/biome lint src/**/*.ts --write",
    "biome-format:fix": "npx @biomejs/biome format src/**/*.ts --write",
    "biome-lint": "npx @biomejs/biome lint src/**/*.ts",
    "biome-format": "npx @biomejs/biome format src/**/*.ts",
    "bundle": "esbuild src/index.ts --bundle --outfile=bundle/authentication-service.js --platform=node  --external:expo-sqlite",
    "start": "ts-node-dev ./src/index.ts",
    "startBundle": "ts-node-dev ./bundle/authentication-service.js",
    "test": "jest",
    "typeorm": "ts-node ./node_modules/typeorm/cli",
    "typeorm:run-migrations": "npm run typeorm migration:run -- -d ./src/typeorm.config.ts",
    "typeorm:generate-migration": "npm run typeorm -- -d ./src/typeorm.config.ts migration:generate ./src/migrations/$npm_config_name",
    "typeorm:create-migration": "npm run typeorm -- migration:create ./src/migrations/$npm_config_name",
    "typeorm:revert-migration": "npm run typeorm -- -d ./src/typeorm.config.ts migration:revert"
  },
  "dependencies": {
    "@inversifyjs/binding-decorators": "^3.0.0",
    "@inversifyjs/http-core": "^5.4.5",
    "@inversifyjs/http-express": "^5.4.5",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "inversify": "^8.1.3",
    "jsonwebtoken": "^9.0.3",
    "password-generator": "^3.0.0",
    "pg": "^8.22.0",
    "save": "^2.9.0",
    "typeorm": "^1.0.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^8.63.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.9.5",
    "ts-jest": "^29.4.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
