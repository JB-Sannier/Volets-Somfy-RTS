{
  "name": "somfyrts-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start:lan": "vite -c vite.config.lan.ts",
    "start:wan": "vite -c vite.config.wan.ts",
    "start:docker": "vite -c vite.config.docker.ts",
    "build": "tsc -b  && vite build -c vite.config.lan.ts",
    "build:lan": "tsc --project tsconfig.lan.json && vite build -c vite.config.lan.ts",
    "build:wan": "tsc --project tsconfig.wan.json && vite build -c vite.config.wan.ts",
    "build:docker": "tsc --project tsconfig.docker.json && vite build -c vite.config.docker.ts",
    "lint": "eslint src/",
    "biome-lint:fix": "npx @biomejs/biome lint src/**/*.ts --write",
    "biome-format:fix": "npx @biomejs/biome format src/**/*.ts --write",
    "biome-lint": "npx @biomejs/biome lint src/**/*.ts",
    "biome-format": "npx @biomejs/biome format src/**/*.ts",
    "preview": "vite preview",
    "format": "prettier --config ./.prettierrc.json --write ./src"
  },
  "dependencies": {
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.6.0",
    "@mui/material": "^9.6.0",
    "axios": "^1.21.1",
    "i18next-browser-languagedetector": "^8.3.1",
    "i18next-http-backend": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-jwt": "^2.1.1",
    "react-router-dom": "^7.18.6"
  },
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
