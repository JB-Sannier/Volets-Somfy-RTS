{
  "name": "swagger-ui-service",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "biome-lint:fix": "npx @biomejs/biome lint src/*.tsx --write",
    "biome-format:fix": "npx @biomejs/biome format src/*.tsx --write",
    "biome-lint": "npx @biomejs/biome lint src/*.tsx",
    "biome-format": "npx @biomejs/biome format src/*.tsx",
    "preview": "vite preview",
    "format": "prettier --write src/**/*.{ts,tsx,css} --config ./.prettierrc.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swagger-ui-react": "^5.36.0"
  },
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
