{
  "name": "swagger-ui-service",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "biome-lint:fix": "npx @biomejs/biome lint src/*.tsx --write",
    "biome-format:fix": "npx @biomejs/biome format src/*.tsx --write",
    "biome-lint": "npx @biomejs/biome lint src/*.tsx",
    "biome-format": "npx @biomejs/biome format src/*.tsx",
    "preview": "vite preview",
    "format": "prettier --write src/**/*.{ts,tsx,css} --config ./.prettierrc.json"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "swagger-ui-react": "^5.32.8"
  },
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "@types/swagger-ui-react": "^5.18.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14"
  }
}